# ==============================================================================
# Next Transfer — environment variable template
# ==============================================================================
# VARIABLE NAMES ONLY. Never commit real values to this file or to this repository.
#
# Copy per environment and keep the copy untracked:
#   cp .env.example .env.local          # local development (Supabase CLI on localhost)
#   cp .env.example .env.development    # development cloud project
#   cp .env.example .env.production     # production project  (values live in CI/secret store only)
#
# Production values are never stored on a developer machine and never in GitHub.
# See docs/architecture/environment-strategy.md for where each value belongs.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Environment identity
# ------------------------------------------------------------------------------
# One of: local | development | production
NEXT_TRANSFER_ENV=
# Human-readable label shown in the app's debug banner for non-production builds.
NEXT_TRANSFER_ENV_LABEL=


# ------------------------------------------------------------------------------
# 2. Supabase — mobile app (client-side, safe to ship in the binary)
# ------------------------------------------------------------------------------
# These two are public by design and are protected by Row Level Security.
# They are still environment-specific: never point a debug build at production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Deep-link scheme used for auth callbacks (magic link / OAuth redirect).
SUPABASE_AUTH_REDIRECT_SCHEME=
SUPABASE_AUTH_REDIRECT_HOST=


# ------------------------------------------------------------------------------
# 3. Supabase — server-side only (CI, admin portal, migrations)
# ------------------------------------------------------------------------------
# NEVER place these in the Flutter app, in a client bundle, or in a NEXT_PUBLIC_ variable.
# Bypasses RLS. CI secret store and Vercel server-side environment only.
SUPABASE_SERVICE_ROLE_KEY=
# Project reference for the Supabase CLI (supabase link --project-ref ...).
SUPABASE_PROJECT_REF=
# Direct Postgres connection string used only by migration jobs.
SUPABASE_DB_URL=
# Access token for the Supabase CLI in CI.
SUPABASE_ACCESS_TOKEN=


# ------------------------------------------------------------------------------
# 4. Storage buckets (private; access only through signed URLs)
# ------------------------------------------------------------------------------
STORAGE_BUCKET_USER_DOCUMENTS=
STORAGE_BUCKET_APPLICATION_FILES=
STORAGE_BUCKET_PROFILE_AVATARS=
# Lifetime in seconds for a generated signed attachment URL.
STORAGE_SIGNED_URL_TTL_SECONDS=


# ------------------------------------------------------------------------------
# 5. Maps and places (Maps and Places module)
# ------------------------------------------------------------------------------
# Restrict every key by platform, application ID, and API surface in the provider console.
MAPS_PROVIDER=
MAPS_API_KEY_ANDROID=
MAPS_API_KEY_IOS=
# Optional geocoding/search key if a different provider is used for place lookup.
PLACES_API_KEY=


# ------------------------------------------------------------------------------
# 6. Notifications (Phase 5)
# ------------------------------------------------------------------------------
PUSH_PROVIDER=
FCM_SENDER_ID=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=


# ------------------------------------------------------------------------------
# 7. Admin portal (apps/admin — Phase 6, deferred)
# ------------------------------------------------------------------------------
# Client-visible values must be the publishable pair only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=
# Server-side session secret for the portal.
ADMIN_PORTAL_SESSION_SECRET=
# Comma-separated list of email domains allowed to sign in to the portal.
ADMIN_PORTAL_ALLOWED_DOMAINS=


# ------------------------------------------------------------------------------
# 8. Content packs
# ------------------------------------------------------------------------------
# Default country pack for a new install (ISO 3166-1 alpha-2), e.g. the Philippines pack.
CONTENT_DEFAULT_COUNTRY=
# Minimum content-pack schema version this build can read.
CONTENT_MIN_SCHEMA_VERSION=


# ------------------------------------------------------------------------------
# 9. Diagnostics — off by default; must never receive sensitive fields
# ------------------------------------------------------------------------------
# Crash reporting and analytics are opt-in and must strip the fields listed in
# docs/security/privacy-classification.md before any event leaves the device.
CRASH_REPORTING_ENABLED=
CRASH_REPORTING_DSN=
ANALYTICS_ENABLED=
ANALYTICS_WRITE_KEY=


# ------------------------------------------------------------------------------
# 10. Feature flags (build-time defaults; server-overridable in Phase 6)
# ------------------------------------------------------------------------------
FEATURE_CLOUD_SYNC_ENABLED=
FEATURE_ATTACHMENTS_ENABLED=
FEATURE_MAPS_ENABLED=
FEATURE_NOTIFICATIONS_ENABLED=
FEATURE_AUTO_COMPLETE_RECURRING=
